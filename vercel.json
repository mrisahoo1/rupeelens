{
  "version": 2,
  "installCommand": "npm ci && python -m pip install -r apps/api/requirements.txt",
  "buildCommand": "npm run build -w apps/web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "apps/api/api/index.py": {
      "runtime": "python3.11",
      "includeFiles": "apps/api/app/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/apps/api/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
